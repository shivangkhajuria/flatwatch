# flatwatch secrets and personal settings. Never commit this file.

# Telegram bot from @BotFather, and your chat id (message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sources to watch, comma-separated. When set, these replace `sources:` in config.yaml.
FLATWATCH_FACEBOOK_GROUPS=
FLATWATCH_SUBREDDITS=

# Only if extract.backend is anthropic_api. Leave unset for agent_sdk (bills your Claude subscription).
# ANTHROPIC_API_KEY=
